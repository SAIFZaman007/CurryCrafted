# Copy to .env.local. Every value is optional: the storefront runs with none of them.

# Canonical public URL. Used for canonical links, Open Graph, sitemap and structured data.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Only if the storefront must run inside a third-party iframe over https (cookies become SameSite=None).
# COOKIE_SAMESITE=none
